@page
@model MeDotNet.Pages.Account.ChangePasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password — JasonObject</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <main class="login-card">
        <h1>Change Password</h1>

        @if (Model.Succeeded)
        {
            <p class="login-success">Your password has been changed.</p>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="login-error"></div>

            <label asp-for="Input.CurrentPassword">Current password</label>
            <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="login-error"></span>

            <label asp-for="Input.NewPassword">New password</label>
            <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="login-error"></span>

            <label asp-for="Input.ConfirmPassword">Confirm new password</label>
            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="login-error"></span>

            <button type="submit">Change Password</button>
        </form>

        <p class="login-note">
            Password must be at least 8 characters and include a number.
        </p>

        <a href="/admin/posts">← Back to posts</a>
    </main>
</body>
</html>
