@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en" data-theme="@(_isDarkMode ? "dark" : "light")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:title" content="Jason St. John — JasonObject" />
    <meta property="og:description" content="A working record of directing AI agents to build production software." />
    <meta property="og:image" content="@SocialCardImageUrl" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="@SocialCardImageUrl" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MeDotNet.styles.css"]" />
    @* Paint the page background on the first byte so there is no light->dark
       flash before MudBlazor's theme CSS applies. data-theme is set on <html>
       from the `theme` cookie (default dark). Values match MudBlazor's default
       Background palette. *@
    <style>
        html[data-theme="dark"], html[data-theme="dark"] body { background-color: #32333d; }
        html[data-theme="light"], html[data-theme="light"] body { background-color: #ffffff; }
    </style>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    @* Persist the theme choice so the server can render it flash-free on the next
       load. Called from the layout's dark-mode toggle. *@
    <script>
        window.jasonObjectTheme = {
            set: function (isDark) {
                try {
                    document.cookie = "theme=" + (isDark ? "dark" : "light") +
                        "; path=/; max-age=31536000; SameSite=Lax";
                    document.documentElement.dataset.theme = isDark ? "dark" : "light";
                } catch (e) { /* cookies blocked: fall back to session-only theme */ }
            }
        };
    </script>
</body>

</html>

@code {
    private const string FallbackCanonicalUrl = "https://jasonobject.work";

    // App.razor renders as static SSR, so HttpContext is available as a cascading
    // parameter here — this is what lets us read the theme cookie before paint.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string CanonicalUrl = string.Empty;
    private string SocialCardImageUrl = string.Empty;
    private bool _isDarkMode;

    protected override void OnInitialized()
    {
        var configuredUrl = Configuration["Site:CanonicalUrl"];
        var baseUrl = string.IsNullOrWhiteSpace(configuredUrl) ? FallbackCanonicalUrl : configuredUrl;

        CanonicalUrl = baseUrl.TrimEnd('/');
        SocialCardImageUrl = $"{CanonicalUrl}/img/social-card.jpg";

        // Default to dark unless the visitor has explicitly chosen light.
        _isDarkMode = HttpContext?.Request.Cookies["theme"] != "light";
    }
}
