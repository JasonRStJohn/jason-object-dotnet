@inherits LayoutComponentBase
@implements IDisposable
@inject IHttpContextAccessor HttpContextAccessor
@inject PersistentComponentState AppState
@inject IJSRuntime JS

<MudThemeProvider Theme="SiteTheme.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="fm-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Toggle navigation" Class="nav-mobile-only mr-1" />
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center">
            <img src="@Assets["img/logo-j.png"]" alt="" width="28" height="28" class="mr-2" style="display: block" />
            <span class="fm-wordmark">JasonObject</span>
        </MudLink>
        <MudSpacer />
        @* NavLink (not MudButton) so the current page gets the `active` class and an underline marker. *@
        <nav class="nav-desktop-only align-center fm-nav mr-4" aria-label="Main">
            <NavLink href="notes" class="fm-nav-link">The Record</NavLink>
            <NavLink href="projects" class="fm-nav-link">Projects</NavLink>
            <NavLink href="about" class="fm-nav-link">About</NavLink>
        </nav>
        <MudButton Href="/work" Variant="Variant.Filled" Color="Color.Secondary" Class="mr-3 cta-wide">
            Work with me
        </MudButton>
        <MudButton Href="/work" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" Class="mr-2 cta-compact">
            Contact
        </MudButton>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleDarkMode" aria-label="Toggle dark mode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary" Elevation="1" Class="d-flex flex-column">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="notes" Icon="@Icons.Material.Filled.Article">The Record</MudNavLink>
            <MudNavLink Href="projects" Icon="@Icons.Material.Filled.Code">Projects</MudNavLink>
            <MudNavLink Href="about" Icon="@Icons.Material.Filled.Person">About</MudNavLink>
            <MudNavLink Href="work" Icon="@Icons.Material.Filled.WorkOutline">Work with me</MudNavLink>
        </MudNavMenu>
        <div class="mt-auto pa-4">
            <MudDivider Class="mb-2" />
            <MudNavMenu>
                <AuthorizeView>
                    <Authorized>
                        <MudNavLink Href="admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Admin</MudNavLink>
                        <MudNavLink Href="admin/posts" Icon="@Icons.Material.Filled.EditNote">Manage Posts</MudNavLink>
                        <MudNavLink Href="admin/projects" Icon="@Icons.Material.Filled.Work">Manage Projects</MudNavLink>
                        <MudNavLink Href="admin/page-text" Icon="@Icons.Material.Filled.TextSnippet">Page Text</MudNavLink>
                        <MudNavLink Href="account/changepassword" Icon="@Icons.Material.Filled.Password">Change Password</MudNavLink>
                        <form method="post" action="/account/logout" class="d-flex px-4 py-2">
                            <AntiforgeryToken />
                            <MudButton ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.Logout"
                                       FullWidth="true" Class="justify-start">Logout</MudButton>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <MudNavLink Href="account/login" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </MudNavMenu>
            <MudDivider Class="my-3" />
            <div class="d-flex justify-center gap-2">
                <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                               Href="https://github.com/JasonRStJohn" Target="_blank" aria-label="GitHub" />
                <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn"
                               Href="https://www.linkedin.com/in/jasonrstjohn" Target="_blank" aria-label="LinkedIn" />
                <MudIconButton Icon="@Icons.Material.Filled.Email"
                               Href="mailto:jasonrstjohn@gmail.com" aria-label="Email" />
            </div>
        </div>
    </MudDrawer>

    <MudMainContent Class="d-flex flex-column flex-grow-1">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 py-sm-8 py-md-10 px-4 px-sm-6 px-md-10 flex-grow-1">
            @Body
        </MudContainer>
        <footer class="site-footer py-4 px-4">
            <MudContainer MaxWidth="MaxWidth.Large" Class="px-2 px-md-6 d-flex flex-wrap align-center justify-space-between gap-2">
                <p class="fm-footer-meta">
                    <span>JasonObject field manual</span>
                    <span aria-hidden="true">|</span>
                    <span>Rev 2026.11</span>
                    <span aria-hidden="true">|</span>
                    <span>Built by a human, with agents, reviewed by the human</span>
                </p>
                <div class="d-flex align-center gap-2">
                    <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small"
                                   Href="https://github.com/JasonRStJohn" Target="_blank" aria-label="GitHub" />
                    <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Size="Size.Small"
                                   Href="https://www.linkedin.com/in/jasonrstjohn" Target="_blank" aria-label="LinkedIn" />
                    <MudIconButton Icon="@Icons.Material.Filled.Email" Size="Size.Small"
                                   Href="mailto:jasonrstjohn@gmail.com" aria-label="Email" />
                    <AuthorizeView>
                        <Authorized>
                            <MudLink Href="/admin" Typo="Typo.caption" Class="ml-2">Admin</MudLink>
                        </Authorized>
                        <NotAuthorized>
                            <MudLink Href="/account/login" Typo="Typo.caption" Class="ml-2 mud-text-secondary">Login</MudLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </MudContainer>
        </footer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string ThemeStateKey = "isDarkMode";

    private bool _isDarkMode;
    private bool _drawerOpen;
    private PersistingComponentStateSubscription _persistSubscription;

    protected override void OnInitialized()
    {
        _persistSubscription = AppState.RegisterOnPersisting(PersistTheme);

        if (AppState.TryTakeFromJson<bool>(ThemeStateKey, out var restored))
        {
            _isDarkMode = restored;
        }
        else
        {
            _isDarkMode = HttpContextAccessor.HttpContext?.Request.Cookies["theme"] != "light";
        }
    }

    private Task PersistTheme()
    {
        AppState.PersistAsJson(ThemeStateKey, _isDarkMode);
        return Task.CompletedTask;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("jasonObjectTheme.set", _isDarkMode);
    }

    public void Dispose() => _persistSubscription.Dispose();
}
