@page "/projects"

<PageTitle>Projects - JasonObject</PageTitle>

<h1 class="mud-typography mud-typography-h3 mud-typography-gutterbottom">Projects</h1>

<MudText Typo="Typo.body1" Class="mb-4">
    Grouped by the kind of problem they solve. Public repositories link straight to GitHub. Client and
    employer systems are described by their architecture so proprietary details stay private.
</MudText>

<div class="d-flex flex-wrap gap-2 mb-6">
    <MudChip T="string" Variant="@(string.IsNullOrWhiteSpace(_activeCategory) ? Variant.Filled : Variant.Outlined)"
             Color="Color.Primary" Href="/projects">
        All Work
    </MudChip>
    @foreach (var group in _groups)
    {
        var capturedId = group.Id;
        var isActive = string.Equals(_activeCategory, capturedId, StringComparison.OrdinalIgnoreCase);
        <MudChip T="string" Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                 Color="Color.Primary" Href="@(isActive ? "/projects" : $"/projects?category={capturedId}")">
            @group.ShortLabel
        </MudChip>
    }
</div>

@foreach (var group in FilteredGroups)
{
    <section id="@group.Id" class="fm-group @GroupAccent(group.Id) mb-10">
        <div class="fm-group-head">
            <h2 class="mud-typography mud-typography-h5 fm-panel-title">@group.Title</h2>
            <span class="fm-tag">@group.Projects.Length systems</span>
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4 fm-measure">@group.Subtitle</MudText>

        @foreach (var project in group.Projects)
        {
            <MudCard Class="mb-4 fm-panel" Elevation="0">
                <MudCardContent>
                    <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-1">
                        <h3 class="mud-typography mud-typography-h6">@project.Title</h3>
                        <span class="fm-tag">@project.Badge</span>
                    </div>
                    <p class="fm-project-meta fm-mono">@project.Meta</p>
                    <MudText Typo="Typo.body1" Class="fm-measure">@project.Body</MudText>
                    @if (project.Employer)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-2 mud-text-secondary">
                            Built during an 8-year tenure as Lead Developer. Proprietary system; ask me about the architecture.
                        </MudText>
                    }
                    @if (project.Tags.Length > 0)
                    {
                        <ul class="fm-stack" aria-label="Stack">
                            @foreach (var tag in project.Tags)
                            {
                                <li>@tag</li>
                            }
                        </ul>
                    }
                </MudCardContent>
                @if (project.LinkHref is not null || project.RecordProject is not null)
                {
                    <MudCardActions>
                        @if (project.LinkHref is not null)
                        {
                            <MudButton Href="@project.LinkHref" Target="_blank" Variant="Variant.Text"
                                       Color="Color.Primary" EndIcon="@Icons.Material.Filled.OpenInNew">
                                @project.LinkText
                            </MudButton>
                        }
                        @if (project.RecordProject is not null)
                        {
                            <MudButton Href="@($"/notes?project={Uri.EscapeDataString(project.RecordProject!)}")" Variant="Variant.Text"
                                       Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">
                                Read the record
                            </MudButton>
                        }
                    </MudCardActions>
                }
            </MudCard>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryFilter { get; set; }

    private string? _activeCategory;

    protected override void OnParametersSet()
    {
        _activeCategory = _groups.Any(g => string.Equals(g.Id, CategoryFilter, StringComparison.OrdinalIgnoreCase))
            ? CategoryFilter
            : null;
    }

    private IEnumerable<ProjectGroup> FilteredGroups =>
        string.IsNullOrWhiteSpace(_activeCategory)
            ? _groups
