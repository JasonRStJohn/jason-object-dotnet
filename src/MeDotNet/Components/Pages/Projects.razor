@page "/projects"
@using MeDotNet.Services.Content
@inject PageCopyService PageCopyService
@inject PersistentComponentState ApplicationState
@implements IDisposable

<PageTitle>Projects - JasonObject</PageTitle>

<h1 class="mud-typography mud-typography-h3 mud-typography-gutterbottom">Projects</h1>

@if (_copy is not null)
{
<div class="mud-typography mud-typography-body1 mb-4 fm-measure fm-copy">@((MarkupString)MarkdownRenderer.ToHtml(_copy.Text(PageTextKeys.ProjectsIntro)))</div>

<div class="d-flex flex-wrap gap-2 mb-6">
    <MudChip T="string" Variant="@(string.IsNullOrWhiteSpace(_activeCategory) ? Variant.Filled : Variant.Outlined)"
             Color="Color.Primary" Href="/projects">
        All Work
    </MudChip>
    @foreach (var group in ShownGroups)
    {
        var capturedId = group.Category.Key;
        var isActive = string.Equals(_activeCategory, capturedId, StringComparison.OrdinalIgnoreCase);
        <MudChip T="string" Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                 Color="Color.Primary" Href="@(isActive ? "/projects" : $"/projects?category={capturedId}")">
            @group.Category.ProjectsShortLabel
        </MudChip>
    }
</div>

@foreach (var group in FilteredGroups)
{
    var category = group.Category;
    <section id="@category.Key" class="fm-group @GroupAccent(category.Key) mb-10">
        <div class="fm-group-head">
            <h2 class="mud-typography mud-typography-h5 fm-panel-title">@category.ProjectsTitle</h2>
            <span class="fm-tag">@group.Projects.Count systems</span>
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4 fm-measure">@category.ProjectsSubtitle</MudText>

        @foreach (var project in group.Projects)
        {
            <MudCard Class="mb-4 fm-panel" Elevation="0">
                <MudCardContent>
                    <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-1">
                        <h3 class="mud-typography mud-typography-h6">@project.Title</h3>
                        <span class="fm-tag">@project.Badge</span>
                    </div>
                    <p class="fm-project-meta fm-mono">@project.Meta</p>
                    <div class="mud-typography mud-typography-body1 fm-measure fm-copy">@((MarkupString)MarkdownRenderer.ToHtml(project.Body))</div>
                    @if (project.IsEmployer)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-2 mud-text-secondary">
                            @_copy.Text(PageTextKeys.ProjectsEmployerNote)
                        </MudText>
                    }
                    @if (project.TagList.Count > 0)
                    {
                        <ul class="fm-stack" aria-label="Stack">
                            @foreach (var tag in project.TagList)
                            {
                                <li>@tag</li>
                            }
                        </ul>
                    }
                </MudCardContent>
                @if (project.LinkHref is not null || project.RecordProject is not null)
                {
                    <MudCardActions>
                        @if (project.LinkHref is not null)
                        {
                            <MudButton Href="@project.LinkHref" Target="_blank" Variant="Variant.Text"
                                       Color="Color.Primary" EndIcon="@Icons.Material.Filled.OpenInNew">
                                @project.LinkText
                            </MudButton>
                        }
                        @if (project.RecordProject is not null)
                        {
                            <MudButton Href="@($"/notes?project={Uri.EscapeDataString(project.RecordProject!)}")" Variant="Variant.Text"
                                       Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">
                                Read the record
                            </MudButton>
                        }
                    </MudCardActions>
                }
            </MudCard>
        }
    </section>
}
}

@code {
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryFilter { get; set; }

    private PageCopy? _copy;
    private string? _activeCategory;
    private PersistentLoader? _loader;

    protected override async Task OnInitializedAsync()
    {
        _loader = new PersistentLoader(ApplicationState);
        _copy = await _loader.LoadAsync("page-copy", PageCopyService.GetAsync);
    }

    protected override void OnParametersSet()
    {
        // An unknown category, or one whose projects are all hidden, shows everything.
        _activeCategory = ShownGroups.Any(g => string.Equals(g.Category.Key, CategoryFilter, StringComparison.OrdinalIgnoreCase))
            ? CategoryFilter
            : null;
    }

    private IEnumerable<CategoryCopy> ShownGroups =>
        _copy?.Categories.Where(c => c.HasVisibleProjects) ?? [];

    private IEnumerable<CategoryCopy> FilteredGroups =>
        string.IsNullOrWhiteSpace(_activeCategory)
            ? ShownGroups
            : ShownGroups.Where(g => string.Equals(g.Category.Key, _activeCategory, StringComparison.OrdinalIgnoreCase));

    // One colour per problem type, shared with the matching /work panel.
    private static string GroupAccent(string id) => id switch
    {
        "ai-systems" => "fm-accent-violet",
        "platforms" => "fm-accent-cyan",
        _ => "fm-accent-green"
    };

    public void Dispose() => _loader?.Dispose();
}
