@page "/work"
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Work with me - JasonObject</PageTitle>

<h1 class="mud-typography mud-typography-h3 mud-typography-gutterbottom">Work with me</h1>

<MudText Typo="Typo.body1" Class="mb-6 fm-measure">
    I take on contract architecture and development work, and I'm open to the right lead or principal
    engineering role. Below are the three problems people usually bring me in to solve.
</MudText>

<MudPaper Class="pa-4 pa-sm-6 mb-4 fm-panel fm-accent-violet" Elevation="0">
    <div class="fm-panel-head">
        <h2 class="mud-typography mud-typography-h5 fm-panel-title">
            1. Curated AI Harnesses &amp; Workflow Architecture
        </h2>
        <span class="fm-tag">Architecture / Sprint</span>
    </div>
    <MudText Typo="Typo.body1" Class="mb-3">
        <strong>The problem:</strong> Organizations adopting AI usually get stuck between two bad options:
        pasting sensitive context into raw chat windows with no guardrails, or buying black-box "agent"
        platforms that hallucinate the moment they touch messy enterprise data.
    </MudText>
    <details class="fm-disclose mb-3">
        <summary>How I approach it</summary>
        <MudText Typo="Typo.body1" Class="mt-2">
            Directing models reliably is an instruction and systems-architecture
        problem. I build constrained, multi-stage harnesses that sit between your existing systems of record
        (ERPs, databases, internal APIs) and the people making decisions. Separating context assembly,
        generation, and cold verification keeps outputs auditable and repeatable.
        </MudText>
    </details>
    <div class="d-flex flex-wrap align-center gap-3">
        <MudButton Href="/projects?category=ai-systems" Variant="Variant.Text" Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward" Class="px-0">
            See the AI harness &amp; workflow systems
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   OnClick="@(() => SelectTrackAndScroll(Tracks[0]))">
            Ask about this track
        </MudButton>
    </div>
</MudPaper>

<MudPaper Class="pa-4 pa-sm-6 mb-4 fm-panel fm-accent-cyan" Elevation="0">
    <div class="fm-panel-head">
        <h2 class="mud-typography mud-typography-h5 fm-panel-title">
            2. Custom Line-of-Business &amp; Civic Software
        </h2>
        <span class="fm-tag">Project / Fractional Lead</span>
    </div>
    <MudText Typo="Typo.body1" Class="mb-3">
        <strong>The problem:</strong> Operations teams, startups, and municipalities regularly outgrow
        spreadsheets and off-the-shelf SaaS, or get trapped paying steep licensing fees for rigid legacy
        software that doesn't match how their people actually work.
    </MudText>
    <details class="fm-disclose mb-3">
        <summary>How I approach it</summary>
        <MudText Typo="Typo.body1" Class="mt-2">
            I architect and ship custom web platforms and automation engines
        in .NET, C#, Vue/Nuxt, and SQL, from multi-workflow production systems and airspace tooling to civic
        utilities and operational dashboards. Clean data models, permissions that match the floor, and
        codebases another engineer can actually maintain.
        </MudText>
    </details>
    <div class="d-flex flex-wrap align-center gap-3">
        <MudButton Href="/projects?category=platforms" Variant="Variant.Text" Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward" Class="px-0">
            See the platform &amp; line-of-business builds
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   OnClick="@(() => SelectTrackAndScroll(Tracks[1]))">
            Ask about this track
        </MudButton>
    </div>
</MudPaper>

<MudPaper Class="pa-4 pa-sm-6 mb-6 fm-panel fm-accent-green" Elevation="0">
    <div class="fm-panel-head">
        <h2 class="mud-typography mud-typography-h5 fm-panel-title">
            3. Legacy Web &amp; Fleet Migrations
        </h2>
        <span class="fm-tag">Fixed-Scope / Retainer</span>
    </div>
    <MudText Typo="Typo.body1" Class="mb-3">
        <strong>The problem:</strong> Small businesses, public library systems, and local governments often
        run on aging WordPress installs buried under twenty plugins. They are slow, fragile on update day, and
        confusing for staff who just need to post an agenda, a catalog update, or an event.
    </MudText>
    <details class="fm-disclose mb-3">
        <summary>How I approach it</summary>
        <MudText Typo="Typo.body1" Class="mt-2">
            I built <strong>ClaudePress</strong> (which currently underlies five
        live production sites, plus vertical layers like <strong>PawPress</strong>). It is a fast, model-agnostic Nuxt 3 +
        PocketBase stack with an admin interface tailored to the organization's actual content, paired with an
        automated migration pipeline that moves sites off WordPress without billing for a hundred hours of
        hand-copying.
        </MudText>
    </details>
    <div class="d-flex flex-wrap align-center gap-3">
        <MudButton Href="/projects?category=claudepress" Variant="Variant.Text" Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward" Class="px-0">
            See the web platforms &amp; migrations
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   OnClick="@(() => SelectTrackAndScroll(Tracks[2]))">
            Ask about this track
        </MudButton>
    </div>
</MudPaper>

<MudPaper Class="pa-4 pa-sm-6 mb-6 fm-panel fm-neutral" Elevation="0">
    <div class="fm-panel-head">
        <h2 class="mud-typography mud-typography-h5 fm-panel-title">How we can work together</h2>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   OnClick="@(() => SelectTrackAndScroll(Tracks[3]))">
            Ask about a leadership role
        </MudButton>
    </div>
    <MudText Typo="Typo.body1" Class="mb-3">
        <strong>Contract &amp; Architecture:</strong> Available for scoped system builds, ERP and AI harness
        architecture, fractional technical leadership, and single-site or fleet web migrations.
    </MudText>
    <MudText Typo="Typo.body1">
        <strong>Full-Time Leadership:</strong> Open to Lead, Staff, or Principal engineering roles (remote
        or around Upstate New York) with teams that value clear architecture and pragmatic AI adoption over hype.
    </MudText>
</MudPaper>

<div id="inquiry">
    <MudPaper Class="pa-4 pa-sm-6 mb-8 fm-panel fm-accent-amber fm-panel-strong" Elevation="0">
        <div class="fm-panel-head">
            <h2 class="mud-typography mud-typography-h5 fm-panel-title">Start a conversation</h2>
            <span class="fm-tag">mailto, no forms, no spam</span>
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Pick a track and timeline below to format a quick note, then open it in your email client or copy it
            to your clipboard. Or skip the form and email <MudLink Href="mailto:jasonrstjohn@gmail.com">jasonrstjohn@gmail.com</MudLink> directly.
        </MudText>

        <MudText Typo="Typo.caption" Class="d-block mb-1">1. What are you looking to solve?</MudText>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (var track in Tracks)
            {
                var captured = track;
                var isSelected = _selectedTrack == captured;
                <MudChip T="string" Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                         Color="Color.Primary" OnClick="@(() => _selectedTrack = captured)" Class="ma-0">
                    @captured
                </MudChip>
            }
        </div>

        <MudText Typo="Typo.caption" Class="d-block mb-1">2. Timeline or scope</MudText>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (var timeline in Timelines)
            {
                var captured = timeline;
                var isSelected = _selectedTimeline == captured;
                <MudChip T="string" Size="Size.Small" Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                         Color="Color.Secondary" OnClick="@(() => _selectedTimeline = captured)" Class="ma-0">
                    @captured
                </MudChip>
            }
        </div>

        <div class="d-flex flex-column gap-4 mb-4">
            <MudTextField @bind-Value="_senderName" Label="Your name or organization (optional)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_brief" Label="Short summary of the problem or role (optional)"
                          Variant="Variant.Outlined" Lines="3"
                          Placeholder="What are you building, migrating, or hiring for?" />
        </div>

        <div class="d-flex flex-wrap align-center gap-3">
            <MudButton Href="@MailtoHref" Variant="Variant.Filled" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Email">
                Open in Email Client
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyInquiryAsync">
                Copy Inquiry &amp; Email Address
            </MudButton>
        </div>
    </MudPaper>
</div>

<h2 class="mud-typography mud-typography-h5 mud-typography-gutterbottom">Direct links</h2>
<MudList T="string" Dense="true">
    <MudListItem T="string" Icon="@Icons.Material.Filled.Email">
        <MudLink Href="mailto:jasonrstjohn@gmail.com">jasonrstjohn@gmail.com</MudLink>
    </MudListItem>
    <MudListItem T="string" Icon="@Icons.Custom.Brands.GitHub">
        <MudLink Href="https://github.com/JasonRStJohn" Target="_blank">github.com/JasonRStJohn</MudLink>
    </MudListItem>
    <MudListItem T="string" Icon="@Icons.Custom.Brands.LinkedIn">
        <MudLink Href="https://www.linkedin.com/in/jasonrstjohn" Target="_blank">linkedin.com/in/jasonrstjohn</MudLink>
    </MudListItem>
</MudList>

@code {
    private static readonly string[] Tracks =
    [
        "AI Harness & Workflow Architecture",
        "Custom Platform / .NET / Vue Build",
        "Legacy Web / ClaudePress Migration",
        "Full-Time / Fractional Leadership"
    ];

    private static readonly string[] Timelines =
    [
        "Immediate / Next 30 Days",
        "Q1 / Q2 Roadmap",
        "Full-Time Role",
        "Exploratory Conversation"
    ];

    private string _selectedTrack = Tracks[0];
    private string _selectedTimeline = Timelines[0];
    private string _senderName = "";
    private string _brief = "";

    private string FormattedSubject =>
        string.IsNullOrWhiteSpace(_senderName)
            ? $"[jasonobject.work] {_selectedTrack}"
            : $"[jasonobject.work] {_selectedTrack} ({_senderName.Trim()})";

    private string FormattedBody =>
        $"Hi Jason,\n\n" +
        $"Track: {_selectedTrack}\n" +
        $"Timeline: {_selectedTimeline}\n" +
        (string.IsNullOrWhiteSpace(_senderName) ? "" : $"From: {_senderName.Trim()}\n") +
        $"\n{(string.IsNullOrWhiteSpace(_brief) ? "[Add a quick note here]" : _brief.Trim())}\n";

    private string MailtoHref =>
        $"mailto:jasonrstjohn@gmail.com?subject={Uri.EscapeDataString(FormattedSubject)}&body={Uri.EscapeDataString(FormattedBody)}";

    private async Task SelectTrackAndScroll(string track)
    {
        _selectedTrack = track;
        await JS.InvokeVoidAsync("jasonObjectClipboard.scrollToId", "inquiry");
    }

    private async Task CopyInquiryAsync()
    {
        var payload = $"To: jasonrstjohn@gmail.com\nSubject: {FormattedSubject}\n\n{FormattedBody}";
        var copied = await JS.InvokeAsync<bool>("jasonObjectClipboard.copy", payload);
        if (copied)
        {
            Snackbar.Add("Copied inquiry and email address (jasonrstjohn@gmail.com) to clipboard.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Could not access clipboard. Email jasonrstjohn@gmail.com directly.", Severity.Warning);
        }
    }
}
