.superpowers/

# .NET build output
bin/
obj/

# User-specific files
*.user
*.suo
.vs/
.idea/
.vscode/

# Secrets (never commit)
.env
appsettings.Local.json

# EF Core migrations backup
*.bak

# OS
.DS_Store
Thumbs.db

# Image working directory (originals, not shipped)
ImagePool/

# Source material — see docs/SOURCES.md. Contains PII; this repo is public.
docs/*.txt
docs/*.jpg

# Editor swap files — a swapfile of .env holds the same secrets .env does
*.swp
*.swo
*~
